# Optional overrides; no API key is required. The process reads environment variables.
# CHATGPT_BROWSER_CHANNEL=chrome
# CHATGPT_BROWSER_EXECUTABLE=C:\path\to\chrome.exe
# CHATGPT_DATA_DIR=D:\private\chatgpt-organizer
# Default: ordinary login window, then a controlled session in the same dedicated profile.
# CHATGPT_TRANSPORT=playwright
# Optional: reuse Chrome 144+ with native connection approval.
# CHATGPT_TRANSPORT=chrome
