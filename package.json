{
  "name": "chatgpt-organizer-mcp",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Organize ChatGPT conversations and projects from your MCP client",
  "bin": {
    "chatgpt-organizer": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/app/*.js",
    "dist/core/*.js",
    "dist/browser/*.js",
    "dist/browser/chromium/*.js",
    "dist/storage/*.js",
    "config/project-routes.example.json",
    "docs/GUIDE.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "package": "npm run build && node dist/tools/release.js",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "login": "node dist/index.js --login",
    "doctor": "node dist/tools/doctor.js",
    "install-browser": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
