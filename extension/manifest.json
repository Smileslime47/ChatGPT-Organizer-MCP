{
  "manifest_version": 3,
  "name": "ChatGPT Organizer Bridge",
  "version": "1.0.0",
  "description": "连接 MCP 客户端与已登录的 ChatGPT，帮助整理会话和项目。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "ChatGPT Organizer 设置",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "key": ""
}
